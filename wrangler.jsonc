{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-sync-kit-todo-example",
  "compatibility_date": "2026-03-29",
  "main": "./src/server/index.tsx",
  "assets": {
    "directory": "dist/client"
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "ProjectRoom"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ProjectRoom",
        "name": "PROJECT_ROOM"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-sync-kit-todo-example-db",
      "database_id": "replace-with-your-database-id"
    }
  ]
}
